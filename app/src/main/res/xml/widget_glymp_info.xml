<?xml version="1.0" encoding="utf-8" ?>
<!-- Konfiguracja widgetu ekranu głównego. updatePeriodMillis to minimalne 30 min; -->
<!-- świeżość zapewniamy też natychmiastowo, gdy aplikacja odbierze nowy odczyt. -->
<appwidget-provider
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:description="@string/widget_description"
  android:initialLayout="@layout/widget_glymp"
  android:minHeight="40dp"
  android:minWidth="180dp"
  android:previewLayout="@layout/widget_glymp"
  android:resizeMode="horizontal|vertical"
  android:updatePeriodMillis="1800000"
  android:widgetCategory="home_screen"
/>
