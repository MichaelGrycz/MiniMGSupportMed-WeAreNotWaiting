---
import SiteLayout from "../../layouts/SiteLayout.astro";
import type { Page } from "../../components/types";

const version = "1.0-beta59";
const apkPath = "/pobierz/minimgsupportmed.apk";

const page: Page = {
    id: "mglycemia",
    path: "/aplikacja/MGlikemia",
    lang: "pl",
    kind: "download",
    title: "MGlikemia — podgląd glikemii MiniMed 780G / 770G / 680G",
    description:
        "Niezależna aplikacja tylko do odczytu dla pomp Medtronic MiniMed. Działa na nowych i starych telefonach z Androidem, ma tryb rodziny, widget i statystyki kliniczne.",
    heading: "MGlikemia / MGlycemia",
    intro: "Podgląd glikemii z pomp MiniMed 780G, 770G i 680G na telefonie, który masz w kieszeni. Bez walki z oficjalną „białą listą” urządzeń.",
    body: "",
    alternates: { pl: "/aplikacja/MGlikemia" },
};

const specs = [
    { key: "Wersja", value: version },
    { key: "System", value: "Android 7.0 lub nowszy" },
    { key: "Obsługiwane pompy", value: "MiniMed 780G, 770G, 680G" },
    { key: "Połączenie", value: "Bluetooth LE" },
    { key: "Konto i serwer", value: "Nie są wymagane" },
    { key: "Tryb pracy", value: "Tylko odczyt" },
];

const steps = [
    {
        title: "Pobierz i zainstaluj",
        text: "Pobierz APK na telefon i otwórz go z listy pobranych plików. Instalacja odbywa się poza Sklepem Google Play.",
    },
    {
        title: "Sparuj pompę",
        text: "W pompie dodaj nowe urządzenie mobilne, a w aplikacji uruchom parowanie. Telefon rozgłasza się jako urządzenie peryferyjne BLE.",
    },
    {
        title: "Ustaw alerty i rodzinę",
        text: "Skonfiguruj progi glikemii, zbiornika i sensora. Opcjonalnie włącz tryb rodziny i przekaż kod QR bliskiej osobie.",
    },
];

const features = [
    {
        title: "100% tylko do odczytu",
        text: "Żadnych bolusów, zmian bazy ani poleceń terapeutycznych. Aplikacja czyta dane i zapisuje je lokalnie.",
    },
    {
        title: "Tryb rodziny i opiekuna",
        text: "Kod parowania i QR pozwalają udostępnić odczyty bliskim bez rozłączania pompy.",
    },
    {
        title: "Widget ekranu głównego",
        text: "Aktualny cukier, trend i IOB na pulpicie, bez otwierania aplikacji.",
    },
    {
        title: "Wykres z prognozą",
        text: "Zoom, przesuwanie, pasma zdarzeń i opcjonalna prognoza 30 min z ostrożnym tłumieniem przez IOB.",
    },
    {
        title: "Statystyki",
        text: "TIR, GMI (szacowane HbA1c), współczynnik zmienności (CV) oraz średnia z wybranego okresu.",
    },
    {
        title: "Progi alertów",
        text: "Progi hipo/hiperglikemii, niski zbiornik, koniec sensora i brak łącza. Alert to informacja — może nie zadziałać (uśpienie telefonu, brak połączenia), więc nie zastępuje pompy ani zaleceń lekarza.",
    },
];

const notes = [
    {
        title: "Wymagania",
        text: "Android 7.0 lub nowszy i Bluetooth LE. Aplikacja nie sprawdza modelu telefonu, więc działa też na sprzęcie, którego nie przyjmuje oficjalna MiniMed Mobile.",
    },
    {
        title: "Bezpieczeństwo",
        text: "Aplikacja nic nie wysyła do pompy i nie zmienia w niej ustawień. To eksperymentalny, niekomercyjny projekt. Nie zastępuje pompy, sensora, zaleceń lekarza ani decyzji o dawkowaniu.",
    },
    {
        title: "Twoje dane",
        text: "Domyślnie zostają w telefonie. Synchronizacja rodziny jest opcjonalna i wymaga własnego serwera; aplikacja nie ma domyślnego adresu.",
    },
];
---

<SiteLayout page={page}>
    <div class="download-view">
        <section class="section-sm download-hero">
            <div class="container download-hero-grid">
                <div class="download-hero-copy">
                    <div class="download-badges">
                        <span class="badge badge-cyan">Open Source</span>
                        <span class="badge badge-subtle">Tylko odczyt</span>
                        <span class="badge badge-subtle">GPL-3.0</span>
                    </div>

                    <h1 class="download-title">
                        MGlikemia / MGlycemia
                        <span class="download-version">{version}</span>
                    </h1>

                    <p class="download-lead">{page.intro}</p>

                    <div class="download-actions">
                        <a class="btn btn-primary download-cta" href={apkPath} download>
                            Pobierz APK
                            <span class="download-cta-meta">Android 7.0+</span>
                        </a>
                        <a class="btn btn-secondary" href="#instalacja">
                            Jak zainstalować
                        </a>
                    </div>

                    <p class="download-fineprint">
                        Niezależne, eksperymentalne narzędzie napisane w MGSupport. Projekt niekomercyjny, nie
                        przechodził certyfikacji ani oceny klinicznej. Nie zastępuje pompy, sensora ani zaleceń lekarza
                        i nie służy do ustalania dawek insuliny.
                    </p>
                </div>

                <aside class="card download-spec-card" aria-label="Najważniejsze informacje o aplikacji">
                    <p class="download-spec-head">W skrócie</p>
                    <dl class="download-specs">
                        {specs.map((spec) => (
                            <div class="download-spec">
                                <dt>{spec.key}</dt>
                                <dd>{spec.value}</dd>
                            </div>
                        ))}
                    </dl>
                </aside>
            </div>
        </section>

        <section class="section-sm download-section" id="instalacja">
            <div class="container">
                <header class="section-header">
                    <span class="badge badge-cyan section-badge">Instalacja</span>
                    <h2 class="section-title">Trzy kroki do pierwszego odczytu</h2>
                    <p class="section-subtitle">Cała instalacja zajmuje kilka minut i nie wymaga zakładania konta.</p>
                </header>

                <ol class="download-steps">
                    {steps.map((step, index) => (
                        <li class="card download-step">
                            <span class="download-step-num">{String(index + 1).padStart(2, "0")}</span>
                            <h3 class="download-step-title">{step.title}</h3>
                            <p class="download-step-text">{step.text}</p>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <section class="section-sm download-section">
            <div class="container">
                <header class="section-header">
                    <span class="badge badge-cyan section-badge">Funkcje</span>
                    <h2 class="section-title">Co dostajesz</h2>
                    <p class="section-subtitle">Pełny podgląd danych z pompy, bez wysyłania poleceń do urządzenia.</p>
                </header>

                <div class="mg-features">
                    {features.map((feature) => (
                        <article class="card download-note">
                            <h2 class="download-note-title">{feature.title}</h2>
                            <p class="download-note-text">{feature.text}</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section class="section-sm download-section">
            <div class="container">
                <div class="download-notes">
                    {notes.map((note) => (
                        <article class="card download-note">
                            <h2 class="download-note-title">{note.title}</h2>
                            <p class="download-note-text">{note.text}</p>
                        </article>
                    ))}
                </div>

                <p class="download-made">
                    Aplikację napisałem w MGSupport. Jeśli potrzebujesz podobnego narzędzia,{" "}
                    <a href="/uslugi/dedykowane-systemy-it-aplikacje-webowe">zobacz systemy IT i aplikacje webowe</a>.
                </p>
                <p class="download-made">
                    Pełny dziennik zmian:{" "}
                    <a href="https://github.com/MichaelGrycz/MiniMGSupportMed-WeAreNotWaiting/blob/public/main/CHANGELOG.md">
                        CHANGELOG na GitHubie
                    </a>
                    .
                </p>
            </div>
        </section>
    </div>
</SiteLayout>

<style>
    .download-hero {
        padding-top: 3rem;
        padding-bottom: 1rem;
    }

    .download-hero-grid {
        display: grid;
        gap: 2.5rem;
        align-items: start;
    }

    .download-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
    }

    .download-title {
        font-size: clamp(1.65rem, 4.5vw, 2.8rem);
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
    }

    .download-version {
        display: inline-block;
        margin-left: 0.35rem;
        color: var(--text-muted);
        font-size: 0.5em;
        font-weight: 600;
        letter-spacing: 0.02em;
        vertical-align: middle;
    }

    .download-lead {
        font-size: 1.1rem;
        color: var(--text-secondary);
        max-width: 56ch;
        margin-bottom: 1.75rem;
    }

    .download-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .download-cta {
        gap: 0.6rem;
        padding-inline: 1.75rem;
    }

    .download-cta-meta {
        font-size: 0.82rem;
        font-weight: 500;
        opacity: 0.75;
    }

    .download-fineprint {
        font-size: 0.85rem;
        color: var(--text-muted);
        max-width: 52ch;
    }

    .download-spec-card {
        padding: 1.5rem 1.5rem 1.25rem;
    }

    .download-spec-head {
        margin: 0 0 1rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent-cyan);
    }

    .download-specs {
        display: grid;
        gap: 0.85rem;
        margin: 0;
    }

    .download-spec {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: 1rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid var(--border-subtle);
    }

    .download-spec:last-child {
        padding-bottom: 0;
        border-bottom: 0;
    }

    .download-spec dt {
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .download-spec dd {
        margin: 0;
        font-size: 0.9rem;
        font-weight: 600;
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .download-section {
        border-top: 1px solid var(--border-subtle);
        scroll-margin-top: 96px;
    }

    .download-steps {
        display: grid;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .download-step {
        padding: 1.5rem;
    }

    .download-step-num {
        display: block;
        margin-bottom: 0.75rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--accent-cyan);
        letter-spacing: 0.08em;
    }

    .download-step-title {
        font-size: 1.05rem;
        margin-bottom: 0.5rem;
    }

    .download-step-text {
        font-size: 0.92rem;
        color: var(--text-secondary);
        margin: 0;
    }

    .download-notes,
    .mg-features {
        display: grid;
        gap: 1.25rem;
    }

    .download-note {
        padding: 1.5rem;
    }

    .download-note-title {
        font-size: 1rem;
        margin-bottom: 0.5rem;
    }

    .download-note-text {
        font-size: 0.92rem;
        color: var(--text-secondary);
        margin: 0;
    }

    .download-made {
        margin: 2.5rem 0 0;
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    .download-made a {
        color: var(--accent-cyan);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    @media (min-width: 768px) {
        .download-steps,
        .download-notes {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .mg-features {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 900px) {
        .download-hero {
            padding-top: 4rem;
        }

        .download-hero-grid {
            grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
            gap: 3.5rem;
            align-items: center;
        }

        .mg-features {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>
