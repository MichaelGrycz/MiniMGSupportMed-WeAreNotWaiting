---
// MGlikemia / MGlycemia — oficjalna strona pobierania i opisu aplikacji.
// Wersja jest podmieniana automatycznie przez tools/release.sh przy każdym wydaniu.
const version = "1.0-beta48";
const title = "MGlikemia — podgląd glikemii MiniMed 780G / 770G / 680G na każdym telefonie";
const description =
    "Niezależna, bezpieczna aplikacja tylko do odczytu dla pomp Medtronic MiniMed. Działa na nowych i starych telefonach z Androidem, oferuje tryb rodziny, widżet ekranu głównego i statystyki kliniczne (TIR, GMI, CV).";
---

<!doctype html>
<html lang="pl">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
        <link rel="canonical" href="https://mgsupport.pl/aplikacja/MGlikemia" />

        <!-- OpenGraph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://mgsupport.pl/aplikacja/MGlikemia" />
        <meta property="og:site_name" content="MGSupport" />
        <meta property="og:locale" content="pl_PL" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />

        <!-- Schema.org -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "MobileApplication",
                "name": "MGlikemia",
                "alternateName": "MGlycemia",
                "operatingSystem": "ANDROID",
                "applicationCategory": "HealthApplication",
                "applicationSubCategory": "Diabetes",
                "isAccessibleForFree": true,
                "downloadUrl": "https://mgsupport.pl/pobierz/minimgsupportmed.apk",
                "softwareVersion": "1.0-beta48",
                "license": "https://www.gnu.org/licenses/gpl-3.0.html",
                "offers": { "@type": "Offer", "price": "0", "priceCurrency": "PLN" },
                "description": "Niezależna aplikacja do odczytu glikemii z pomp Medtronic MiniMed 780G, 770G i 680G."
            }
        </script>

        <style>
            :root {
                --bg-base: #0b0f17;
                --bg-surface: #121926;
                --bg-elevated: #1a2333;
                --border: #233044;
                --text-primary: #f8fafc;
                --text-secondary: #94a3b8;
                --text-muted: #64748b;
                --accent: #06b6d4;
                --accent-bright: #22d3ee;
                --accent-bg: rgba(6, 182, 212, 0.12);
                --green: #10b981;
            }
            * {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                background: var(--bg-base);
                color: var(--text-primary);
                line-height: 1.65;
                -webkit-font-smoothing: antialiased;
            }
            .wrap {
                max-width: 860px;
                margin: 0 auto;
                padding: 48px 20px 64px;
            }
            header {
                text-align: center;
                margin-bottom: 40px;
            }
            .badge {
                display: inline-block;
                background: var(--accent-bg);
                color: var(--accent-bright);
                padding: 5px 12px;
                border-radius: 999px;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 0.04em;
                text-transform: uppercase;
            }
            h1 {
                font-size: clamp(28px, 5vw, 40px);
                line-height: 1.15;
                margin: 16px 0 8px;
            }
            .lead {
                color: var(--text-secondary);
                font-size: 18px;
                margin: 0 auto;
                max-width: 640px;
            }
            .card {
                background: var(--bg-surface);
                border: 1px solid var(--border);
                border-radius: 18px;
                padding: 26px 28px;
                margin-top: 20px;
            }
            .download {
                text-align: center;
                background: linear-gradient(180deg, #12212e, var(--bg-surface));
            }
            .download h2 {
                margin-top: 0;
            }
            .btn {
                display: inline-block;
                background: var(--accent);
                color: #04121a;
                font-weight: 800;
                text-decoration: none;
                padding: 15px 32px;
                border-radius: 12px;
                font-size: 17px;
                transition: background 0.15s ease;
            }
            .btn:hover {
                background: var(--accent-bright);
            }
            .meta {
                color: var(--text-muted);
                font-size: 13px;
                margin-top: 14px;
            }
            h2 {
                font-size: 21px;
                margin: 0 0 10px;
            }
            h3 {
                font-size: 16px;
                margin: 18px 0 4px;
                color: var(--accent-bright);
            }
            p {
                color: var(--text-secondary);
                margin: 8px 0;
            }
            ul {
                color: var(--text-secondary);
                padding-left: 22px;
                margin: 8px 0;
            }
            li {
                margin: 6px 0;
            }
            strong {
                color: var(--text-primary);
            }
            a {
                color: var(--accent-bright);
            }
            .grid {
                display: grid;
                gap: 14px;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                margin-top: 14px;
            }
            .tile {
                background: var(--bg-elevated);
                border: 1px solid var(--border);
                border-radius: 14px;
                padding: 16px;
            }
            .tile h3 {
                margin-top: 0;
            }
            .tile p {
                margin: 4px 0 0;
                font-size: 14px;
            }
            .safety {
                border-left: 3px solid var(--green);
            }
            .footer {
                text-align: center;
                color: var(--text-muted);
                font-size: 13px;
                margin-top: 44px;
            }
            .footer a {
                color: var(--text-secondary);
            }
            code {
                background: #0f1722;
                padding: 2px 6px;
                border-radius: 6px;
                color: var(--accent-bright);
            }
        </style>
    </head>
    <body>
        <div class="wrap">
            <header>
                <span class="badge">Open Source · Tylko do odczytu · GPL-3.0</span>
                <h1>MGlikemia / MGlycemia</h1>
                <p class="lead">
                    Niezależny podgląd glikemii z pomp Medtronic MiniMed 780G, 770G i 680G — na telefonie, który masz w
                    kieszeni. Bez walki z oficjalną „białą listą” urządzeń.
                </p>
            </header>

            <section class="card download">
                <h2>Pobierz najnowszą wersję</h2>
                <p>Instalacja na Androidzie 7.0 lub nowszym. Plik APK instalujesz bezpośrednio na telefonie.</p>
                <p style="margin-top:18px">
                    <a class="btn" href="/pobierz/minimgsupportmed.apk" rel="nofollow">
                        Pobierz APK · wersja {version}
                    </a>
                </p>
                <p class="meta">Wymagania: Android 7.0+ · Bluetooth LE · pompa MiniMed 700-serii · 100% odczyt</p>
            </section>

            <section class="card">
                <h2>Po co powstała ta aplikacja?</h2>
                <p>
                    Oficjalna aplikacja Medtronic działa tylko na wąskiej liście telefonów. Wystarczy nowszy model albo
                    aktualizacja Androida, a podgląd cukru potrafi zniknąć na wiele miesięcy — ludzie noszą drugi, stary
                    telefon wyłącznie po to, by widzieć glikemię.
                </p>
                <p>
                    <strong>MGlikemia rozwiązuje ten problem.</strong> Korzysta z Bluetooth LE w standardzie i działa na
                    nowoczesnych oraz starszych urządzeniach z Androidem. Telefon jest peryferium, pompa jest centralem
                    — aplikacja tylko odbiera dane.
                </p>
            </section>

            <section class="card">
                <h2>Najważniejsze funkcje</h2>
                <div class="grid">
                    <div class="tile safety">
                        <h3>100% tylko do odczytu</h3>
                        <p>
                            Żadnych bolusów, zmian bazy ani poleceń terapeutycznych. Aplikacja czyta dane i zapisuje je
                            lokalnie.
                        </p>
                    </div>
                    <div class="tile">
                        <h3>Tryb rodziny i opiekuna</h3>
                        <p>
                            Udostępniaj odczyty bliskim na ich telefonach bez rozłączania pompy — dla mamy, taty, żony,
                            męża, partnera.
                        </p>
                    </div>
                    <div class="tile">
                        <h3>Widget ekranu głównego</h3>
                        <p>Aktualny cukier, trend i IOB na pulpicie, bez otwierania aplikacji.</p>
                    </div>
                    <div class="tile">
                        <h3>Statystyki kliniczne</h3>
                        <p>TIR, GMI (szacowane HbA1c), współczynnik zmienności (CV) oraz wykresy od godziny do roku.</p>
                    </div>
                    <div class="tile">
                        <h3>Alerty pod Twoje potrzeby</h3>
                        <p>
                            Konfigurowalne progi hipo/hiperglikemii, niski zbiornik, koniec sensora i brak połączenia.
                        </p>
                    </div>
                    <div class="tile">
                        <h3>Kopia zapasowa CSV</h3>
                        <p>
                            Eksport i import danych na telefonie — bez chmury, bez konta, bez wysyłania danych
                            medycznych.
                        </p>
                    </div>
                </div>
            </section>

            <section class="card">
                <h2>Jak to działa?</h2>
                <ul>
                    <li>
                        <strong>Parowanie:</strong> w pompie wybierz dodanie nowego urządzenia mobilnego, a w aplikacji
                        uruchom parowanie. Telefon rozgłasza się jako urządzenie peryferyjne BLE.
                    </li>
                    <li>
                        <strong>Odczyt:</strong> po uwierzytelnieniu pompa przesyła glikemię, trend, IOB, bazę, baterię
                        i poziom zbiornika.
                    </li>
                    <li>
                        <strong>Tryb opiekuna:</strong> drugi telefon z tą samą aplikacją może odbierać odczyty
                        lokalnie, bez podłączania się do pompy.
                    </li>
                    <li>
                        <strong>Prywatność:</strong> dane zostają na telefonie. Synchronizacja w chmurze jest opcjonalna
                        i wyłączona domyślnie.
                    </li>
                </ul>
            </section>

            <section class="card">
                <h2>Bezpieczeństwo i odpowiedzialność</h2>
                <p>
                    Aplikacja jest narzędziem pomocniczym i <strong>nie jest wyrobem medycznym</strong>. Nie zastępuje
                    oficjalnych zaleceń lekarza ani terapii. Decyzje o leczeniu podejmuj zawsze na podstawie oficjalnych
                    źródeł i konsultacji ze specjalistą.
                </p>
            </section>

            <section class="card">
                <h2>Historia zmian i źródła</h2>
                <p>
                    Pełny dziennik zmian:
                    <a href="https://github.com/MichaelGrycz/MiniMGSupportMed-WeAreNotWaiting/blob/public/main/CHANGELOG.md">
                        CHANGELOG na GitHubie
                    </a>
                    .
                </p>
                <p>
                    Kod źródłowy i wydania:
                    <a href="https://github.com/MichaelGrycz/MiniMGSupportMed-WeAreNotWaiting/releases">
                        GitHub Releases
                    </a>
                    .
                </p>
                <p>
                    Starszy, poprzedni adres strony <code>/pobierz/minimgsupportmed</code> przekierowuje automatycznie
                    tutaj.
                </p>
            </section>

            <div class="footer">
                <p>Projekt nie jest powiązany z firmą Medtronic. MiniMed jest znakiem towarowym Medtronic.</p>
                <p>&copy; MGSupport Michał Grycz · licencja GNU GPL-3.0</p>
            </div>
        </div>
    </body>
</html>
